# Copy this file to `.env` when an AI coding agent should run Django,
# tests, workers, and assets on the host while Docker Compose provides
# Postgres, Redis, Mailhog, and optional local service emulators.

DEBUG=on
ENVIRONMENT=dev

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=
# SERVICE_NAME=
# SERVICE_VERSION=

SECRET_KEY="super-secret-key"
# Keep this aligned with `LOCAL_WEB_PORT` or `DJANGO_RUNSERVER_PORT`.
SITE_URL=http://localhost:8000
ALLOW_SIGNUPS=True

# Host ports published by docker-compose-local.yml. Change these when running
# multiple generated projects on one machine, then update the matching
# POSTGRES_PORT, REDIS_PORT, EMAIL_PORT, URLs, and SITE_URL values below.
LOCAL_WEB_PORT=8000
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_MAILHOG_SMTP_PORT=1025
LOCAL_MAILHOG_UI_PORT=8025


LOCAL_MINIO_API_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001


# Optional Docker Compose namespace. Set this when running two clones with the
# same directory name or same generated project slug.
# COMPOSE_PROJECT_NAME=tastefulkit-agent

# Connect host-run Django to Compose-published Postgres.
POSTGRES_HOST=localhost
POSTGRES_DB=tastefulkit
POSTGRES_USER=tastefulkit
POSTGRES_PORT=5432
POSTGRES_PASSWORD=tastefulkit
DATABASE_URL=

# Connect host-run Django and Django Q2 to Compose-published Redis.
REDIS_HOST=localhost
REDIS_PASSWORD=tastefulkit
REDIS_PORT=6379
REDIS_DB=0
# Leave REDIS_URL blank so REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and REDIS_DB
# stay authoritative when LOCAL_REDIS_PORT changes. Set a full URL only for an
# external Redis service.
REDIS_URL=

# Override these when two same-slug clones intentionally share one Redis service.
LOCAL_INSTANCE_ID=tastefulkit
CACHE_KEY_PREFIX=tastefulkit
Q_CLUSTER_NAME=tastefulkit-q

# Print development emails to the terminal so agent runs do not require Mailhog.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


# Keep this aligned with LOCAL_MINIO_API_PORT when using Minio from the host.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=tastefulkit
AWS_SECRET_ACCESS_KEY=tastefulkit
AWS_S3_BUCKET_NAME=tastefulkit


MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.tastefulkit.app
DEFAULT_FROM_EMAIL=LVTD, LLC from TastefulKit <hello@tastefulkit.app>
SERVER_EMAIL=TastefulKit Errors <error@tastefulkit.app>


# Leave empty unless a task calls ping_healthchecks(...).
HEALTHCHECKS_PING_BASE_URL=












POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LOGS_ENABLED=False
POSTHOG_LOG_LEVEL=INFO
