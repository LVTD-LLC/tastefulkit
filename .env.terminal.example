# Copy this file to `.env` when running the generated app directly on your
# machine without Docker. Keep `.env.example` for Docker Compose defaults.

DEBUG=on
ENVIRONMENT=dev

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=
# SERVICE_NAME=
# SERVICE_VERSION=

SECRET_KEY="super-secret-key"
# If you start Django with `DJANGO_RUNSERVER_PORT=<port> make terminal-web`,
# update SITE_URL to the same port.
SITE_URL=http://localhost:8000
ALLOW_SIGNUPS=True

# Local Postgres. Create this database/user locally or replace these values
# with DATABASE_URL for your own local Postgres service.
POSTGRES_HOST=localhost
POSTGRES_DB=tastefulkit
POSTGRES_USER=tastefulkit
POSTGRES_PORT=5432
POSTGRES_PASSWORD=tastefulkit
DATABASE_URL=

# Local Redis without a password, matching common package-manager installs.
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Override these when two same-slug clones intentionally share one Redis service.
LOCAL_INSTANCE_ID=tastefulkit
CACHE_KEY_PREFIX=tastefulkit
Q_CLUSTER_NAME=tastefulkit-q

# Print development emails to the terminal so Mailhog is not required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Leave blank for local filesystem media storage when Minio is not running.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=tastefulkit

MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.tastefulkit.app
DEFAULT_FROM_EMAIL=LVTD, LLC from TastefulKit <hello@tastefulkit.app>
SERVER_EMAIL=TastefulKit Errors <error@tastefulkit.app>

# Leave empty unless a task calls ping_healthchecks(...).
HEALTHCHECKS_PING_BASE_URL=










POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LOGS_ENABLED=False
POSTHOG_LOG_LEVEL=INFO
